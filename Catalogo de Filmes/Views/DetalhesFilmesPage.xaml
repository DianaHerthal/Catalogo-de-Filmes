<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Catalogo_de_Filmes.Views.DetalhesFilmesPage"
             Title="Detalhes do Filme">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Image Source="{Binding Filme.ImagemUrl}" HeightRequest="300" Aspect="AspectFit"/>

            <Label Text="{Binding Filme.Titulo}" FontSize="26" FontAttributes="Bold" HorizontalOptions="Center" TextColor="Black"/>
            <Label Text="{Binding Filme.Genero}" FontSize="16" FontAttributes="Italic" HorizontalOptions="Center" TextColor="Gray"/>

            <BoxView HeightRequest="1" Color="LightGray" Margin="0,10"/>

            <Label Text="Sinopse" FontAttributes="Bold" FontSize="20" TextColor="#0052cc"/>
            <Label Text="{Binding Filme.Sinopse}" FontSize="16" LineHeight="1.4" TextColor="#333333"/>

            <Button Text="Editar Informações" 
                    Command="{Binding IrParaEdicaoCommand}" 
                    BackgroundColor="#0052cc" 
                    TextColor="White" 
                    Margin="0,30,0,0"
                    CornerRadius="8"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>