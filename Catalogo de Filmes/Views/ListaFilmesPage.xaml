<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Catalogo_de_Filmes.Models"
             xmlns:viewmodels="clr-namespace:Catalogo_de_Filmes.ViewModels"
             x:Class="Catalogo_de_Filmes.Views.ListaFilmesPage"
             Title="Meu Catálogo Real">

    <Grid RowDefinitions="Auto, *">

        <Grid Grid.Row="0" ColumnDefinitions="*, *" ColumnSpacing="10" Margin="15,15,15,5">

            <Button Grid.Column="0" 
                    Text="+ Novo Filme" 
                    Command="{Binding IrParaCadastroCommand}" 
                    BackgroundColor="#0052cc" 
                    TextColor="White"
                    CornerRadius="8"
                    FontAttributes="Bold"
                    HeightRequest="45"/>

            <Button Grid.Column="1" 
                    Text="⚙️ Gerenciar Gêneros" 
                    Command="{Binding IrParaGenerosCommand}" 
                    BackgroundColor="#6c757d" 
                    TextColor="White"
                    CornerRadius="8"
                    FontAttributes="Bold"
                    HeightRequest="45"/>
        </Grid>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Filmes}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Filme">
                    <Frame Margin="15,5,15,10" Padding="0" CornerRadius="10" HasShadow="True">
                        <Grid ColumnDefinitions="120, *, Auto">

                            <Image Grid.Column="0" Source="{Binding ImagemUrl}" HeightRequest="180" Aspect="AspectFill" />

                            <VerticalStackLayout Grid.Column="1" Margin="15">
                                <Label Text="{Binding Titulo}" FontAttributes="Bold" FontSize="18" TextColor="#333333" />
                                <Label Text="{Binding Genero}" TextColor="#888888" FontSize="14" />
                                <Label Text="{Binding Sinopse}" MaxLines="3" LineBreakMode="TailTruncation" FontSize="14" Margin="0,5,0,0"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="10" Margin="0,0,15,0">
                                <Button Text="Ver" 
                                        BackgroundColor="#28a745"
                                        TextColor="White"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ListaFilmes}}, Path=IrParaDetalhesCommand}"
                                        CommandParameter="{Binding .}" />

                                <Button Text="Apagar" 
                                        BackgroundColor="#dc3545" 
                                        TextColor="White"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ListaFilmes}}, Path=RemoverFilmeCommand}"
                                        CommandParameter="{Binding .}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>